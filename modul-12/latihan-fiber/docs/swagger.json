        "/courses/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "courses"
                ],
                "summary": "Detail satu kelas",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID kelas",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
