		{
			"name": "2 Daftar Kelas (jalankan psql, bukan Postman)",
			"description": "Daftarkan Vito dan Budi ke kelas IF101 lewat psql:\n\npsql -U postgres -d praktikum_backend -c \"INSERT INTO enrollments (course_id, student_id) SELECT 1, id FROM students WHERE nim IN ('434241084','434241085') ON CONFLICT DO NOTHING;\"\n\nRina sengaja TIDAK didaftarkan untuk uji 403 NOT_ENROLLED.",
			"item": [
				{
					"name": "Cek pendaftaran (psql di luar Postman)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/health",
						"description": "Pengingat saja: jalankan perintah psql pada deskripsi folder sebelum lanjut."
					}
				}
			]
